{
  "name": "voice-agent-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Claude（ツール実行）と Gemini Live（音声）を組み合わせた、ブラウザ完結型エージェントの最小シェル",
  "scripts": {
    "predev": "npm run build:runtime",
    "dev": "vite",
    "prebuild": "npm run build:runtime",
    "build": "vite build",
    "build:runtime": "vite build -c vite.runtime.config.js",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@google/genai": "^2.17.1",
    "@observablehq/plot": "^0.6.17",
    "@turf/turf": "^7.4.0",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-dsv": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-geo-polygon": "^2.0.1",
    "d3-geo-projection": "^4.0.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.0"
  }
}
